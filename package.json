{
  "name": "fish-free-mcp",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc && esbuild src/web.ts --bundle --format=esm --outfile=dist/public/app.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/server.js",
    "preview:local": "tsx test/fixture-server.ts",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.27",
    "@better-auth/oauth-provider": "1.7.27",
    "@better-auth/passkey": "1.7.27",
    "@hono/node-server": "2.1.11",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-auth": "1.7.27",
    "hono": "4.13.20",
    "undici": "8.13.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "A single-owner, passkey-protected MCP gateway for Fish S2.1 Pro Free and Gemini.",
  "license": "UNLICENSED"
}
